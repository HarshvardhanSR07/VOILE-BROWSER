{
  "manifest_version": 3,
  "name": "Voile — Privacy-First Browser Interface & Chameleon Shield",
  "version": "1.1.0",
  "description": "Privacy-first browser companion with Tor/Mullvad-standard anti-fingerprinting and pre-flight secret leak guard.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Voile"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["chameleon_shield.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "48": "assets/voile-logo.svg"
  }
}
