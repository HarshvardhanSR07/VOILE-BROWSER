# Voile Browser: Environment Variables Configuration Template
# Copy this file to .env and insert your API keys.
# .env is ignored by Git to secure all credentials and keys.

VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_GROQ_MODEL=qwen/qwen3.8-27b

VITE_TAVILY_API_KEY=your_tavily_api_key_here
VITE_TAVILY_API_URL=https://api.tavily.com/search

VITE_COGNEE_BASE_URL=https://your-tenant-id.aws.cognee.ai
VITE_COGNEE_API_KEY=your_cognee_api_key_here
